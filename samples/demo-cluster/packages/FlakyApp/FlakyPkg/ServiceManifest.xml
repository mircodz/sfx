<?xml version="1.0" encoding="utf-8"?>
<!-- Exits as soon as it starts, so the cluster keeps reporting failed activations. -->
<ServiceManifest Name="FlakyPkg" Version="1.0.0" xmlns="http://schemas.microsoft.com/2011/01/fabric" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ServiceTypes>
    <StatelessServiceType ServiceTypeName="FlakyType" UseImplicitHost="true" />
  </ServiceTypes>
  <CodePackage Name="Code" Version="1.0.0">
    <EntryPoint>
      <ExeHost>
        <Program>run.sh</Program>
      </ExeHost>
    </EntryPoint>
  </CodePackage>
</ServiceManifest>
