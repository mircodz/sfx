<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sfx</AssemblyName>
    <RootNamespace>Sfx</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sfx</ToolCommandName>
    <PackageId>sfx</PackageId>
    <Description>Azure Service Fabric Explorer for the terminal and the browser: browse nodes, applications, services, partitions and replicas, read health, manifests, upgrades and events, and run cluster operations, with confirmations and an action log.</Description>
    <PackageTags>azure;service-fabric;servicefabric;service-fabric-explorer;sfx;cluster;explorer;tui;terminal;cli;web-ui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sfx.Tui\Sfx.Tui.csproj" />
  </ItemGroup>

</Project>
