<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sfx</AssemblyName>
    <RootNamespace>Sfx</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sfx</ToolCommandName>
    <PackageId>sfx</PackageId>
    <Description>A k9s-style terminal UI for Azure Service Fabric clusters: browse nodes, applications, services, partitions and replicas, inspect health and manifests, and run cluster operations.</Description>
    <PackageTags>service-fabric;servicefabric;tui;terminal;cli;k9s;azure</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sfx.Tui\Sfx.Tui.csproj" />
  </ItemGroup>

</Project>
